{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "styled",
      "file-types": ["javascript", "typescript"],
      "highlights": ["node_modules/tree-sitter-css/queries/highlights.scm"],
      "camelcase": "Styled",
      "title": "Styled",
      "scope": "source.css",
      "class-name": "TreeSitterStyled"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "ISC",
    "description": "Styled grammar for tree-sitter",
    "authors": [
      {
        "name": "Mark Skelton"
      }
    ],
    "links": {
      "repository": "https://github.com/mskelton/tree-sitter-styled"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": true,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
